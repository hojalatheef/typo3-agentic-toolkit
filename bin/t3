#!/usr/bin/env bash
# t3 — run the TYPO3 console of the current project, DDEV-aware.
#
# Usage: t3 [--print] <typo3 command> [args...]   e.g. t3 cache:flush
#
# Walks up from the working directory to the project root (the first folder
# with vendor/bin/typo3, typo3/sysext/core/bin/typo3 or .ddev/). Inside DDEV
# it runs `ddev exec vendor/bin/typo3 ...`, otherwise `vendor/bin/typo3 ...`
# (or the classic-mode binary). --print only prints the command line.
# Exit code 2 when no console binary is found.

set -euo pipefail

print=0
[[ "${1:-}" == --print ]] && { print=1; shift; }
[[ "${1:-}" == -h || "${1:-}" == --help ]] && { sed -n '2,11p' "$0"; exit 0; }

dir="$PWD"
while [[ "$dir" != / ]]; do
  [[ -e "$dir/vendor/bin/typo3" || -e "$dir/typo3/sysext/core/bin/typo3" || -d "$dir/.ddev" ]] && break
  dir="$(dirname "$dir")"
done

