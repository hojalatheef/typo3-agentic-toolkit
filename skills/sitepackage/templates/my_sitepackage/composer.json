{
    "name": "my-vendor/my-sitepackage",
    "description": "Site package for TYPO3 v14 (site set + PAGEVIEW)",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\MySitepackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "my_sitepackage"
        }
    }
}
